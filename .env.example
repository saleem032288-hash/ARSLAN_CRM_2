# =====================================================================
# WACRM environment template
#
# Copy this file to `.env.local` and fill in your real values:
#   cp .env.example .env.local
#
# NEVER commit real credentials. This file only contains placeholders.
# =====================================================================

# --- Required -------------------------------------------------------

# Supabase project URL (Settings → API → Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (Settings → API → Project API keys).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (Settings → API → service_role).
# SERVER-ONLY. Never expose to the browser. Bypasses RLS — treat as a master key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption key — 64 hex chars = 32 bytes (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# --- Recommended ----------------------------------------------------

# Canonical public URL of this deployment (scheme + host, no trailing slash).
# Used for invite links. It must be the URL where invite emails land.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# UI catalogues: en | ko | pt | es (default: en).
NEXT_PUBLIC_APP_LOCALE=en

# --- Optional -------------------------------------------------------

# Defense-in-depth allow-list for invitation redeem hosts, comma-separated.
# When set, invites can only be redeemed from a browser whose Origin
# matches one of these hosts.
# ALLOWED_INVITE_HOSTS=

# Shared secret guarding /api/automations/cron and /api/flows/cron.
# REQUIRED when a Wait step / scheduled resume is used; without it those
# cron endpoints refuse to run.
# AUTOMATION_CRON_SECRET=

# Meta App credentials are per-connection (stored AES-256-GCM-encrypted on
# the whatsapp_config row, set from Settings → WhatsApp connection).
# The two vars below are an OPTIONAL fallback for existing deployments.
# META_APP_ID=
# META_APP_SECRET=

# CI/local template testing without a real WABA:
# WHATSAPP_TEMPLATES_DRY_RUN=true

# AI provider timeouts / context limits:
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20